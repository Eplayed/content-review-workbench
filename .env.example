# 复制为 .env 后按需修改（.env 已在 .gitignore 中）
# 公网部署时请务必设置 APP_PASSWORD

# 服务端口
PORT=3000

# 数据目录（SQLite 文件与自定义规则存放处）
DATA_DIR=./data

# 访问鉴权：设置后浏览器会弹出原生登录框；用户名默认 admin
# APP_PASSWORD=change-me
# APP_USER=admin

# 供脚本 / CI 调用的 Bearer 凭证（与 APP_PASSWORD 可同时使用）
# AUTH_TOKEN=

# AI 供应商：openai = 任意 OpenAI 兼容接口（含 Ollama）；fake = 确定性假草稿（测试用，不调外网）
# AI_PROVIDER=openai
